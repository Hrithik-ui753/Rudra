[TEMPLATE]
# RUDRA Backend Environment Configuration
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash
DATA_DIR=../DATA
CORS_ORIGINS=["*"]
HOST=0.0.0.0
PORT=8000

# Authentication
# true  -> accept legacy demo tokens ("Bearer user_<id>") for local development/tests
# false -> require a real, verified Firebase ID token on every protected endpoint
AUTH_DEV_MODE=true
# Firebase project id (used to verify ID-token signature/audience/issuer)
FIREBASE_PROJECT_ID=rudra-ff130
